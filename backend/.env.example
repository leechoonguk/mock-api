ENV=local
APP_NAME=Mock API
# Relative to backend/ - make dev and start.sh run from there and create data/.
DATABASE_URL=sqlite+aiosqlite:///./data/mock.db
ALLOWED_HOSTS=["localhost","127.0.0.1"]
# The admin UI's origin (Vite). Unsafe admin requests from any other browser
# origin are refused.
CSRF_TRUSTED_ORIGINS=["http://localhost:47823","http://127.0.0.1:47823"]
CORS_ORIGINS=["*"]
ITEMS_PER_USER=20
# The forward proxy browsers and apps point at (127.0.0.1:PROXY_PORT), and where
# its CA lives - generated on first start; install mitmproxy-ca-cert.pem as trusted.
PROXY_ENABLED=true
PROXY_PORT=47822
PROXY_CONFDIR=./data/mitmproxy
# Recorded bodies over 64 KiB or binary (images, video segments), one file each.
BODY_STORE_DIR=./data/bodies
