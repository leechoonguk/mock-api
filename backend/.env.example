ENV=local
APP_NAME=Mock API
# Relative to backend/ - make dev and start.sh run from there and create data/.
DATABASE_URL=sqlite+aiosqlite:///./data/mock.db
ALLOWED_HOSTS=["localhost","127.0.0.1"]
# The admin UI's origin (Vite). Unsafe admin requests from any other browser
# origin are refused; the mocks under /mock/ accept every origin.
CSRF_TRUSTED_ORIGINS=["http://localhost:47823","http://127.0.0.1:47823"]
CORS_ORIGINS=["*"]
ITEMS_PER_USER=20
